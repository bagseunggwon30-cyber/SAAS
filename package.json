{
  "name": "xg5000-assistant-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "description": "Desktop operating console for XG5000 field assistance, PLC monitoring, and guided troubleshooting.",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run rebuild:electron-native",
    "dev": "electron-vite dev",
    "dev:wsl": "DISPLAY=:0 NO_SANDBOX=1 ELECTRON_CLI_ARGS='[\"--disable-gpu\"]' electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "npm run rebuild:electron-native",
    "preview": "electron-vite preview",
    "pretest": "npm rebuild better-sqlite3",
    "posttest": "npm run rebuild:electron-native",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron-native": "node node_modules/.pnpm/@electron+rebuild@4.0.3/node_modules/@electron/rebuild/lib/cli.js -f -w better-sqlite3",
    "test:e2e": "npm run rebuild:electron-native && playwright test",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "node-opcua": "2.158.0",
    "node-opcua-certificate-manager": "2.157.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
